{
  "description": "dw guard rails (no force push, no push to the base branch, no deletion outside the repo, no PR merge through MCP) and desktop notifications when a human is needed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.mjs"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*(merge|accept).*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.mjs"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notify.mjs", "--hook"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
